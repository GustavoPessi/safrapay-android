<?xml version="1.0" encoding="utf-8"?>
<!-- Botão redondo do chat (microfone / enviar). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="@color/green_300" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/green_900" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/green_700" /></shape>
    </item>
</selector>
