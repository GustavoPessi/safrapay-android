<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm" />

    <TextView android:id="@+id/txtPensando"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg" android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/chat_pensando"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <!-- Barra de digitação estilo WhatsApp: clipe (câmera/galeria/arquivo) à esquerda,
         campo com quase toda a largura e um botão redondo que é microfone com o campo
         vazio e vira "enviar" quando há texto. -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="@dimen/space_xs" android:paddingEnd="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_sm"
        android:gravity="bottom">

        <ImageButton android:id="@+id/btnAnexo"
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_anexar"
            android:src="@drawable/ic_chat_anexo" />

        <EditText android:id="@+id/edtMensagem"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="@drawable/bg_input"
            android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:hint="@string/chat_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <ImageButton android:id="@+id/btnAcao"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_chat_acao"
            android:contentDescription="@string/chat_audio"
            android:src="@drawable/ic_chat_mic_branco" />
    </LinearLayout>
</LinearLayout>
