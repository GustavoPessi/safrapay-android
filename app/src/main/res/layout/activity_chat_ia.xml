<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm" />

    <TextView android:id="@+id/txtPensando"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg" android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/chat_pensando"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <!-- Bandeja de fotos antes de enviar (estilo WhatsApp): miniaturas com ✕; dá pra juntar
         câmera + galeria (até 5) e escrever um texto. Enviar manda tudo junto. -->
    <HorizontalScrollView android:id="@+id/scrollBandeja"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout android:id="@+id/bandeja"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Barra de digitação estilo WhatsApp: clipe (câmera/galeria/arquivo) à esquerda,
         campo com quase toda a largura e um botão redondo que é microfone (segurar = gravar
         mensagem de voz) com o campo vazio e vira "enviar" quando há texto.
         Clipe, campo e botão têm 48dp de altura: numa linha, os ícones ficam centralizados;
         quando o texto cresce, eles descem junto com a última linha (gravity bottom). -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="@dimen/space_xs" android:paddingEnd="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_sm"
        android:gravity="bottom">

        <ImageButton android:id="@+id/btnAnexo"
            android:layout_width="44dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_anexar"
            android:src="@drawable/ic_chat_anexo" />

        <FrameLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText android:id="@+id/edtMensagem"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical|start"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:hint="@string/chat_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <!-- Aparece no lugar do campo enquanto o microfone está pressionado. -->
            <TextView android:id="@+id/txtGravando"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton android:id="@+id/btnAcao"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_chat_acao"
            android:contentDescription="@string/chat_gravar_audio"
            android:src="@drawable/ic_chat_mic_branco" />
    </LinearLayout>
</LinearLayout>
