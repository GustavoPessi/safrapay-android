<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md" android:background="@drawable/bg_card"
    android:orientation="vertical" android:padding="@dimen/space_md">

    <TextView android:id="@+id/txtDescricao" style="@style/Text.H2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="@dimen/text_body" />
    <TextView android:id="@+id/txtPropriedade" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="@dimen/text_caption" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresso"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        app:indicatorColor="@color/green_700"
        app:trackColor="@color/green_100"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <TextView android:id="@+id/txtProgresso" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs" android:textSize="@dimen/text_caption" />
</LinearLayout>
