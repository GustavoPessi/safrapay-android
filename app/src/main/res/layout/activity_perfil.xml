<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@color/green_100"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_person"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtNome"
            style="@style/Text.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_email"
                android:textColor="@color/text_hint" android:textSize="@dimen/text_caption" />
            <TextView android:id="@+id/txtEmail" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_md" android:background="@color/outline" />

            <TextView style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_cpf"
                android:textColor="@color/text_hint" android:textSize="@dimen/text_caption" />
            <TextView android:id="@+id/txtCpf" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_md" android:background="@color/outline" />

            <TextView style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_telefone"
                android:textColor="@color/text_hint" android:textSize="@dimen/text_caption" />
            <TextView android:id="@+id/txtTelefone" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_md" android:background="@color/outline" />

            <TextView style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/label_nascimento"
                android:textColor="@color/text_hint" android:textSize="@dimen/text_caption" />
            <TextView android:id="@+id/txtNascimento" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <Button android:id="@+id/btnEditar" style="@style/Widget.App.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/perfil_editar" />

        <!-- Multiusuário: equipe (dono gerencia; gerente/colaborador veem de quem é e podem sair). -->
        <TextView style="@style/Text.Body" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg"
            android:text="@string/equipe_secao" android:textColor="@color/text_hint"
            android:textSize="@dimen/text_caption" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:background="@drawable/bg_card"
            android:orientation="vertical">
            <TextView android:id="@+id/txtEquipeInfo" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:textColor="@color/text_primary" android:visibility="gone" />
            <TextView android:id="@+id/rowMinhaEquipe" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/equipe_minha" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" />
            <TextView android:id="@+id/rowConvites" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/equipe_convites_recebidos" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:id="@+id/divSairEquipe" android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/outline" android:visibility="gone" />
            <TextView android:id="@+id/rowSairEquipe" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/equipe_sair" android:textColor="@color/error"
                android:background="?attr/selectableItemBackground" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/txtLabelCadastros" style="@style/Text.Body" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg"
            android:text="@string/perfil_cadastros" android:textColor="@color/text_hint"
            android:textSize="@dimen/text_caption" />

        <LinearLayout android:id="@+id/cardCadastros" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:background="@drawable/bg_card"
            android:orientation="vertical">
            <TextView android:id="@+id/rowPropriedades" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/perfil_propriedades" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" />
            <TextView android:id="@+id/rowMaquinas" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/perfil_maquinas" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" />
            <TextView android:id="@+id/rowSincronizar" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/perfil_sincronizar" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical">
            <TextView android:id="@+id/rowConfig" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/perfil_configuracoes" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:id="@+id/divNotif" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" />
            <TextView android:id="@+id/rowNotif" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/perfil_notificacoes" android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" />
            <TextView android:id="@+id/rowSair" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="@dimen/space_md"
                android:text="@string/acao_sair" android:textColor="@color/error"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
