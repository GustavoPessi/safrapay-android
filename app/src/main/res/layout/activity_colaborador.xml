<?xml version="1.0" encoding="utf-8"?>
<!-- Telas 35/36 • App do colaborador (online): máquinas com contadores e tarefas com filtros. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg" android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_md">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/txtOla" style="@style/Text.H2"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txtFazenda" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
            <Button android:id="@+id/btnPerfil" style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/colab_perfil" />
        </LinearLayout>

        <include layout="@layout/view_banner_convite" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/abas"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/green_700"
            app:tabSelectedTextColor="@color/green_700"
            app:tabTextColor="@color/text_secondary" />

        <!-- Filtros das tarefas (só na aba Tarefas). -->
        <HorizontalScrollView android:id="@+id/scrollFiltros"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none" android:visibility="gone">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsFiltro"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- "Tarefas de <máquina>  ✕" quando veio de "Ver tarefas" de uma máquina. -->
        <TextView android:id="@+id/txtFiltroMaquina" style="@style/Text.Body"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textColor="@color/green_900"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <TextView android:id="@+id/txtEstado" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:visibility="gone" />
            <LinearLayout android:id="@+id/lista"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
