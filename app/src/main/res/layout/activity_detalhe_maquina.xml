<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg">

        <TextView android:id="@+id/txtNome" style="@style/Text.H1"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txtSubtitulo" style="@style/Text.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_md">
            <TextView style="@style/Text.Body" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/maq_gasto_total"
                android:textSize="@dimen/text_caption" android:visibility="gone" />
            <TextView android:id="@+id/txtGasto" style="@style/Text.H1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/despesa" android:textSize="26sp" />
            <TextView android:id="@+id/txtExtra" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Despesas vinculadas -->
        <TextView style="@style/Text.H2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg"
            android:text="@string/maq_despesas_titulo" android:textSize="@dimen/text_body" />
        <LinearLayout android:id="@+id/containerDespesas" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm" />
        <TextView android:id="@+id/txtSemDespesas" style="@style/Text.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/maq_sem_despesas" android:visibility="gone" />

        <!-- Anotações -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView style="@style/Text.H2" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/maq_anotacoes_titulo"
                android:textSize="@dimen/text_body" />
            <Button android:id="@+id/btnNovaAnotacao" style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/maq_nova_anotacao" />
        </LinearLayout>
        <LinearLayout android:id="@+id/containerAnotacoes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/txtSemAnotacoes" style="@style/Text.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/maq_sem_anotacoes" android:visibility="gone" />

        <Button android:id="@+id/btnEditar" style="@style/Widget.App.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/acao_editar" />
        <Button android:id="@+id/btnExcluir" style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" android:text="@string/acao_excluir"
            android:textColor="@color/error" />
    </LinearLayout>
</ScrollView>
