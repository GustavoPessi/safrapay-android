<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/cabecalho"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">
        <TextView android:id="@+id/txtTitulo" style="@style/Text.Body"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary" android:textStyle="bold" />
        <ImageView android:id="@+id/imgSeta"
            android:layout_width="20dp" android:layout_height="20dp"
            android:rotation="90"
            android:src="@drawable/ic_chevron" android:contentDescription="@null" />
    </LinearLayout>

    <TextView android:id="@+id/txtTexto" style="@style/Text.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_md" android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />
</LinearLayout>
