<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatura de uma foto na bandeja do chat (antes de enviar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp" android:layout_height="68dp"
    android:layout_marginEnd="@dimen/space_sm">

    <ImageView android:id="@+id/imgMiniatura"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/background"
        android:contentDescription="@string/chat_bandeja_foto"
        android:scaleType="centerCrop" />

    <TextView android:id="@+id/btnRemover"
        android:layout_width="24dp" android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/bg_bandeja_remover"
        android:contentDescription="@string/chat_bandeja_remover"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/white"
        android:textSize="12sp" />
</FrameLayout>
