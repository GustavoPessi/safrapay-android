<?xml version="1.0" encoding="utf-8"?>
<!-- Mensagem de voz do produtor: play + duração; embaixo, o texto que o servidor entendeu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="end"
    android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="180dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_user"
        android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_sm">

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton android:id="@+id/btnTocar"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_audio_tocar"
                android:src="@drawable/ic_chat_play" />

            <TextView android:id="@+id/txtDuracao"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/chat_audio_rotulo"
                android:textColor="@color/white"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView android:id="@+id/txtTranscricao"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:paddingStart="@dimen/space_xs"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
