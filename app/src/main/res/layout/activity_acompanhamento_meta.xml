<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_lg">

        <TextView android:id="@+id/txtDescricao" style="@style/Text.H1"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txtPropriedade" style="@style/Text.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <!-- Progresso -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <TextView android:id="@+id/txtValores" style="@style/Text.H2"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtPercentual" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/green_700" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresso"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:indicatorColor="@color/green_700" app:trackColor="@color/green_100"
                app:trackCornerRadius="4dp" app:trackThickness="10dp" />
            <TextView android:id="@+id/txtFalta" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />
            <TextView android:id="@+id/txtPrazo" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Estimativas (calculadora de sacas) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_md">
            <TextView style="@style/Text.H2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/meta_estimativas"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" android:hint="@string/hint_preco_saca">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPrecoSaca" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="numberDecimal"
                    android:maxLength="12" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/txtEstimativa" style="@style/Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/meta_sacas_info" />
        </LinearLayout>

        <Button android:id="@+id/btnEditar" style="@style/Widget.App.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/acao_editar" />
        <Button android:id="@+id/btnExcluir" style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" android:text="@string/acao_excluir"
            android:textColor="@color/error" />
    </LinearLayout>
</ScrollView>
