<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de lançamento: descrição com a largura toda; embaixo, data à esquerda e valor à direita
     (antes o valor dividia a linha com a descrição e, com milhões, cortava a descrição). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md" android:background="@drawable/bg_card"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:padding="@dimen/space_md">

    <ImageView android:id="@+id/imgTipo" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@color/green_100" android:padding="6dp"
        android:src="@drawable/ic_receita" android:contentDescription="@null" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="@dimen/space_md"
        android:orientation="vertical">
        <TextView android:id="@+id/txtDescricao" style="@style/Text.H2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="@dimen/text_body" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/txtData" style="@style/Text.Body"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:maxLines="1"
                android:textSize="@dimen/text_caption" />
            <TextView android:id="@+id/txtValor" style="@style/Text.H2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:maxLines="1" android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
