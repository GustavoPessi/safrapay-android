<?xml version="1.0" encoding="utf-8"?>
<!-- Pastas que o FileProvider pode compartilhar com outros apps.
     "exports": arquivos do "Exportar relatório" (PDF/Excel/CSV), gerados em cacheDir/exports. -->
<paths>
    <cache-path name="exports" path="exports/" />
    <!-- "chat": fotos tiradas pela câmera no assistente de IA (cacheDir/chat), lidas pelo app da câmera via FileProvider. -->
    <cache-path name="chat" path="chat/" />
</paths>
